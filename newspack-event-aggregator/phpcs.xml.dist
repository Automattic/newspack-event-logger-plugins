<?xml version="1.0"?>
<ruleset name="Newspack Event Aggregator">
	<description>PHP Coding Standards for Newspack Event Aggregator</description>

	<!-- What to scan -->
	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>*.asset.php</exclude-pattern>

	<!-- How to scan -->
	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<!-- Rules -->
	<rule ref="WordPress-VIP-Go">
		<!-- Allow short array syntax -->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		<!-- Allow arrow functions -->
		<exclude name="Generic.WhiteSpace.ArrowFunctionSpacing"/>
	</rule>

	<!-- Allow short ternary -->
	<rule ref="WordPress.PHP.DisallowShortTernary">
		<exclude name="WordPress.PHP.DisallowShortTernary.Found"/>
	</rule>

	<!-- Minimum PHP version -->
	<config name="minimum_supported_wp_version" value="6.0"/>
	<config name="testVersion" value="8.0-"/>
</ruleset>
